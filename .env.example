# Copy to .env and fill with the staging Supabase project
# (same values as creator-assist-new/.env.local — publishable key only).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Website origin used for account deletion + waitlist admin APIs.
EXPO_PUBLIC_WEBSITE_URL=http://localhost:3000

# Same emails as website ADMIN_EMAILS (UI only — API still enforces server-side).
EXPO_PUBLIC_ADMIN_EMAILS=you@example.com
