{
  "expo": {
    "name": "Creator Assist",
    "slug": "creator-assist-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "creatorassist",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.creatorassist.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "EXDevMenuShowFloatingActionButton": false,
        "EXDevMenuShowsAtLaunch": false,
        "EXDevMenuIsOnboardingFinished": true
      },
      "appleTeamId": "764RS49AS6"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6F9A86",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.creatorassist.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Creator Assist to update your profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
